# Copy to .env for local runs. On Railway, set these in the service's Variables tab instead.
# Never commit the real .env.

# Discord bot
token=
# Channel the anticheat embeds are posted into
anticheatChannelID=

# Slash commands (/monitor needs these)
applicationID=
guildIDs=["YOUR_GUILD_ID"]
# Role allowed to use /monitor (this is the default, only set it to change it)
moderatorRoleID=1561315326304714884

# Game -> bot bridge
# Long random string. The same value goes in the game's BridgeConfig.Secret.
webhookSecret=

# Port the bot listens on. The Railway domain's port must be the same number.
PORT=800

# Where the flag database lives. Leave it empty on Railway with a volume attached, it uses the volume automatically.
# Locally it defaults to ./data/botstuff.db
# databasePath=
